# For local development (without Docker)
MQTT_HOST=localhost
MQTT_PORT=1883
FRIGATE_HOST=localhost
FRIGATE_PORT=5000

# When running via docker-compose, these are set automatically
# in the compose file (MQTT_HOST=mosquitto, FRIGATE_HOST=frigate)

# --- Person-detection backend ---
# auto (default) = LocateAnything-3B when its service answers, YOLOv8n when it
# does not. "vlm" = grounding model only, no fallback. "yolo" = YOLO only.
# DETECTION_BACKEND=auto
# The prompt the grounding model counts people with. Tuned, not cosmetic:
# "person" made it report trash receptacles as people on 6 of 240 labelled
# frames; "pedestrian" produced zero false positives. See bench/README.md.
# PERSON_QUERY=pedestrian
# Seconds a failed grounding-service probe is trusted before retrying, so a
# machine with no GPU does not pay a connection timeout every cycle.
# VLM_PROBE_INTERVAL=60

# --- Open-vocabulary queries (optional, off by default) ---
# Requires services/locate_anything/server.py running on a Linux host with an
# NVIDIA GPU. The weights are licensed for academic and non-profit research
# only — see the licence note in the README before enabling this.
# VLM_ENABLED=1
# VLM_BASE_URL=http://localhost:8100
# VLM_TIMEOUT=120
# Longest image side sent for inference. 1440 is the measured operating point
# on a 24GB card (bench/README.md); higher needs more VRAM than a 4090 has.
# VLM_MAX_IMAGE_SIDE=1440
# Seconds between open-vocabulary passes per camera.
# OPEN_VOCAB_INTERVAL=300
